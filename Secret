// src/consoleEasterEgg.ts
export function consoleEasterEgg(message: string): void {
  console.log(`%c🐣 ${message}`, 'color: #ff69b4; font-weight: bold; font-size: 16px');
}

// src/onKonamiCode.ts
export function onKonamiCode(callback: () => void): void {
  const sequence = [
    'ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown',
    'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'
  ];
  let current = 0;

  window.addEventListener('keydown', (e) => {
    if (e.key === sequence[current]) {
      current++;
      if (current === sequence.length) {
        callback();
        current = 0;
      }
    } else {
      current = 0;
    }
  });
}

// src/confettiRain.ts
export function confettiRain(): void {
  const confetti = document.createElement('div');
  confetti.innerText = '🎉';
  confetti.style.position = 'fixed';
  confetti.style.top = '10px';
  confetti.style.left = '10px';
  confetti.style.fontSize = '40px';
  document.body.appendChild(confetti);
  setTimeout(() => confetti.remove(), 3000);
}

// src/blinkTitle.ts
export function blinkTitle(message: string, interval = 1000): void {
  const original = document.title;
  let showing = false;
  const id = setInterval(() => {
    document.title = showing ? original : message;
    showing = !showing;
  }, interval);

  window.addEventListener('blur', () => clearInterval(id));
}
